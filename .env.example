# Cadena de conexión: gestor://usuario:contraseña@servidor:puerto/base
DATABASE_URL=postgresql://postgres:123456@localhost:5432/talenthub_dev
PORT=3000
# Base separada para las pruebas del adaptador PostgreSQL
TEST_DATABASE_URL=postgresql://postgres:123456@localhost:5432/talenthub_dev_test

# MongoDB. La base de pruebas debe ser distinta de la de desarrollo.
MONGODB_URI=mongodb://localhost:27017/talenthub_dev
MONGODB_TEST_URI=mongodb://localhost:27017/talenthub_dev_test

# prisma usa PostgreSQL a través de Prisma. Si se omite, las vacantes usan pg.
VACANCIES_ADAPTER=prisma